{
  "name": "malmodle",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "build/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malmodle",
      "database_id": "REPLACE_WITH_THE_ID_FROM_wrangler_d1_create",
      "migrations_dir": "worker/migrations"
    }
  ],
  "routes": [
    { "pattern": "malmodle.se", "custom_domain": true }
  ]
}
